<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:focusableInTouchMode="true">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_sender_1_text" android:textSize="12sp" android:textColor="#2563EB" android:layout_marginBottom="12dp" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_sender_2_text" android:textSize="30sp" android:textColor="#1C2942" android:layout_marginBottom="12dp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_sender_3_text" android:textSize="14sp" android:textColor="#63718A" android:layout_marginBottom="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:layout_marginTop="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_sender_4_text" android:textSize="18sp" android:textColor="#1C2942" android:layout_marginBottom="12dp" android:textStyle="bold" />
            <EditText android:id="@+id/send_message" android:layout_width="match_parent" android:layout_height="140dp" android:gravity="top" android:inputType="textMultiLine" android:maxLength="500" android:hint="@string/activity_sender_send_message_hint" android:textSize="18sp" />
            <Button android:id="@+id/send" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/activity_sender_send_text" android:textSize="16sp" android:textColor="#FFFFFF" android:backgroundTint="#2563EB" android:layout_marginTop="12dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:layout_marginTop="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_sender_7_text" android:textSize="18sp" android:textColor="#1C2942" android:layout_marginBottom="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_sender_send_status_text" android:textSize="16sp" android:textColor="#2563EB" android:layout_marginBottom="12dp" android:id="@+id/send_status" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_sender_9_text" android:textSize="14sp" android:textColor="#63718A" android:layout_marginBottom="12dp" android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>